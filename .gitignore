# Maven build output
target/
dependency-reduced-pom.xml

# jpackage native installer output
dist/
jpackage-input/
jpackage-temp/

# Frontend build stamp, generated by the release workflow
static/build-info.json

# Compiled class files
*.class

# Logs
logs/
*.log

# Runtime data (contains real competitor personal data - never commit)
data.json
# Relay management runtime data (meet days, relays, lane assignments)
relays.json
# Team management runtime data (teams of the team disciplines)
teams.json
# This installation's discipline catalog (started from default-disciplines.json), kept on deploys
catalog.json
catalog.legacy.json
# Where older versions kept the catalog; older deploy scripts still copy it, the app ignores it
disciplines.json
disciplines.legacy.json
# This meet's rankings
rankings.json
# Files of older versions, no longer used
competition.json
disciplines.local.json
# The meet's name, venue, host and dates
meet.json
# Machine-specific settings (external backup receiver URL)
appsettings.json
disciplines.previous.json*
# Safety copies of the data taken before a backup is restored
backups/
*.backup

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Deploy secrets/config (see deploy/pct.env.example)
deploy/pct.env

# Test feeder: event data extracted from results PDFs (real competitor names)
tools/testfeeder/data/

# Registration portal: runtime data (registrations, i.e. personal data - never commit)
registration-portal/portal-data/
