# Copy to deploy/pct.env and adjust, then run deploy/pct-create.sh on the
# Proxmox host. deploy/pct.env is git-ignored. Any variable left unset
# falls back to the default described in pct-create.sh's header comment.

# CTID=200
HOSTNAME=mlaiccmanager
STORAGE=local-lvm
TEMPLATE_STORAGE=local
DISK_GB=8
CORES=1
MEMORY_MB=1024
SWAP_MB=512
BRIDGE=vmbr0

# Static IP example (comment out for dhcp):
# IP_CONFIG=192.168.1.50/24
# GATEWAY=192.168.1.1

# Public key for root SSH login (must be the PUBLIC key of the machine
# that will scp/ssh in to run deploy/setup.sh — copy it to the Proxmox
# host first if needed). Defaults to ~/.ssh/id_ed25519.pub or
# ~/.ssh/id_rsa.pub on the Proxmox host's root account if unset.
# SSH_PUBKEY_FILE=/root/.ssh/id_ed25519.pub
