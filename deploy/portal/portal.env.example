# Settings of the registration portal, read by its services and the scripts
# in /opt/mlaic-portal. portal-install.sh writes /etc/mlaic-portal/portal.env
# from the options it is given and never overwrites it later; change it here
# and restart (systemctl restart mlaic-portal). It holds no secrets (root, 0644).

# The public address, exactly as clubs type it (no trailing slash). Writes are
# accepted only from this origin, and an https:// address turns on the secure
# __Host- session cookie.
PORTAL_BASE_URL=https://anmeldung.example.org

# Where the portal listens: 127.0.0.1 behind the reverse proxy on the same
# machine (Caddy). 0.0.0.0 only for a test in your own network, without HTTPS.
PORTAL_BIND=127.0.0.1
PORTAL_PORT=8080

PORTAL_DATA_DIR=/var/lib/mlaic-portal

# Update check before every start (portal-update.sh); false freezes the version
PORTAL_AUTO_UPDATE=true

# --- backup (portal-backup.sh, daily via mlaic-portal-backup.timer) ---
# Encrypted copies, kept this many days
BACKUP_DIR=/var/backups/mlaic-portal
BACKUP_KEEP_LOCAL_DAYS=30
# age public key(s), one per line; the private key never comes onto the server
BACKUP_AGE_RECIPIENTS=/etc/mlaic-portal/backup-recipients.txt
# Optional: a command that copies each new backup somewhere else; the file's
# path is appended. Runs as the portal's user. Examples:
#   BACKUP_COPY_COMMAND="rclone copy --config /etc/mlaic-portal/rclone.conf {} offsite:mlaic-portal"
#   BACKUP_COPY_COMMAND="scp -i /etc/mlaic-portal/backup-ssh-key -q {} backup@nas.example.org:mlaic-portal/"
BACKUP_COPY_COMMAND=
