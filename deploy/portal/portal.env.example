# Settings of the registration portal and its backup, read by
# mlaic-portal.service, mlaic-portal-backup.service and the scripts in
# /opt/mlaic-portal. Install as /etc/mlaic-portal/portal.env (root, 0644: it
# holds no secrets). See setup-oci.md.

# The public address, exactly as clubs type it (no trailing slash). Writes are
# accepted only from this origin, and an https:// address turns on the secure
# __Host- session cookie.
PORTAL_BASE_URL=https://anmeldung.example.org

# Where the portal listens: only the reverse proxy on the same machine may
# reach it. Never 0.0.0.0.
PORTAL_BIND=127.0.0.1
PORTAL_PORT=8080

PORTAL_DATA_DIR=/var/lib/mlaic-portal
PORTAL_STATIC_DIR=/opt/mlaic-portal/static

# --- backup (portal-backup.sh) ---
# Encrypted local copies, kept this many days
BACKUP_DIR=/var/backups/mlaic-portal
BACKUP_KEEP_LOCAL_DAYS=7
# age public key(s), one per line; the private key never comes onto the VM
BACKUP_AGE_RECIPIENTS=/etc/mlaic-portal/backup-recipients.txt
# OCI Object Storage bucket for the off-site copy (empty: local copies only).
# Uploaded with the VM's instance principal, so no API key is stored here.
BACKUP_OCI_BUCKET=mlaic-portal-backups
BACKUP_OCI_CLI=/usr/local/bin/oci
