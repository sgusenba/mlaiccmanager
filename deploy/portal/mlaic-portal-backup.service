# One backup of the registration portal's data: portal-backup.sh packs it,
# encrypts it with age and uploads it to OCI Object Storage. Started daily by
# mlaic-portal-backup.timer, and by portal-deploy.sh before an update.
#
# Install together with the timer (see setup-oci.md):
#   cp mlaic-portal-backup.service mlaic-portal-backup.timer /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now mlaic-portal-backup.timer
# Run one now:   systemctl start mlaic-portal-backup && journalctl -u mlaic-portal-backup -n 20

[Unit]
Description=Backup of the MLAIC registration portal
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mlaic-portal
Group=mlaic-portal
EnvironmentFile=/etc/mlaic-portal/portal.env
# The OCI CLI wants a home directory; it stores nothing secret there
Environment=HOME=/var/backups/mlaic-portal
ExecStart=/opt/mlaic-portal/portal-backup.sh daily
UMask=0077
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/mlaic-portal
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
