# One backup of the registration portal's data: portal-backup.sh packs it,
# encrypts it with age and, if set up, copies it elsewhere. Started daily by
# mlaic-portal-backup.timer (portal-install.sh enables it once a backup key is
# given); portal-update.sh takes one before installing a new build.
# Run one now:   systemctl start mlaic-portal-backup && journalctl -u mlaic-portal-backup -n 20

[Unit]
Description=Backup of the MLAIC registration portal
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mlaic-portal
Group=mlaic-portal
EnvironmentFile=/etc/mlaic-portal/portal.env
# A home for the copy command's tools (rclone, ssh)
Environment=HOME=/var/backups/mlaic-portal
ExecStart=/opt/mlaic-portal/portal-backup.sh daily
UMask=0077
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/mlaic-portal
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
