# systemd unit for MLAICC Manager itself.
#
# Installed automatically by deploy/setup.sh. Runs the jar that
# deploy/git-deploy.sh builds and symlinks into the persistent run
# directory (default: /opt/mlaiccmanager/run/mlaiccmanager.jar).
# data.json and logs/ live in that same run directory and survive
# every rebuild/redeploy.

[Unit]
Description=MLAICC Manager
After=network.target

[Service]
Type=simple
User=mlaicc
Group=mlaicc
WorkingDirectory=/opt/mlaiccmanager/run
ExecStart=/usr/bin/java -jar /opt/mlaiccmanager/run/mlaiccmanager.jar
Restart=on-failure
RestartSec=5

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/mlaiccmanager/run

[Install]
WantedBy=multi-user.target
